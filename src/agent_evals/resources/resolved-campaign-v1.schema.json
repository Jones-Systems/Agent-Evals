        "campaign_id",
        "version",
        "suite_sha256",
        "input_sha256",
        "cases",
        "arms",
        "repetitions",
        "profile_matrix",
        "intentionally_varied_dimensions",
        "outcome_policy",
        "budget_policy",
        "safety_stop_policy_refs",
        "counterbalance"
