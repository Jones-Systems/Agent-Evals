        "outcome": {
          "enum": [
            "pass_rate",
            "dimension_score",
            "resource_use"
          ]
        },
        "retry_rule": {
          "enum": [
            "no_retry",
            "preserve_trial_identity"
          ]
        },
        "uncertainty_rule": {
          "enum": [
            "descriptive_only",
            "none"
          ]
        },
        "upper_bound": {
          "type": "number"
        }
