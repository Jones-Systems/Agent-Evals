      "type": "object"
    },
    "CounterbalancePolicy": {
      "additionalProperties": false,
      "properties": {
        "algorithm_revision": {
          "enum": [
            "agent-evals-counterbalance-v1"
          ]
        },
        "method": {
          "enum": [
            "fixed",
            "balanced_rotation"
          ]
        },
        "seed": {
          "maximum": 1000000000000000,
          "minimum": -1000000000000000,
          "type": "integer"
        }
      },
      "required": [
        "method",
