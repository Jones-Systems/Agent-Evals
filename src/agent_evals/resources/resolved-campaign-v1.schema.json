        "input_sha256": {
          "maxLength": 32768,
          "type": "string"
        },
        "intentionally_varied_dimensions": {
          "items": {
            "enum": [
              "provider",
              "surface",
              "model",
              "model_revision",
              "reasoning",
              "runtime",
              "runtime_revision",
              "agent_topology",
              "tool_policy_ref",
              "network_policy_ref"
            ]
          },
          "maxItems": 100000,
          "type": "array"
        },
        "outcome_policy": {
          "$ref": "#/$defs/OutcomePolicy"
        },
        "profile_matrix": {
          "items": {
            "$ref": "#/$defs/ProfileAssignment"
          },
          "maxItems": 100000,
          "type": "array"
        },
        "repetitions": {
          "maximum": 1000000000000000,
          "minimum": -1000000000000000,
          "type": "integer"
        },
        "safety_stop_policy_refs": {
          "items": {
            "maxLength": 32768,
            "type": "string"
          },
          "maxItems": 100000,
          "type": "array"
        },
        "suite_sha256": {
          "maxLength": 32768,
          "type": "string"
