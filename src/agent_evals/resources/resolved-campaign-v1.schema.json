        },
        "arm_id": {
          "maxLength": 32768,
          "type": "string"
        },
        "case_id": {
          "maxLength": 32768,
          "type": "string"
        },
        "case_sha256": {
          "maxLength": 32768,
          "type": "string"
        },
        "input_sha256": {
          "maxLength": 32768,
          "type": "string"
        },
        "repetition": {
          "maximum": 1000000000000000,
          "minimum": -1000000000000000,
          "type": "integer"
