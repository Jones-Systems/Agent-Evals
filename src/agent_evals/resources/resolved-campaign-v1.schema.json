        "failure_rule": {
          "enum": [
            "count_as_failure",
            "report_separately"
          ]
        },
        "lower_bound": {
          "type": "number"
        },
        "missingness_rule": {
          "enum": [
            "fail_closed",
            "report_separately"
          ]
