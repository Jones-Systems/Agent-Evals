        },
        "provider": {
          "maxLength": 32768,
          "type": "string"
        },
        "reasoning": {
          "maxLength": 32768,
          "type": "string"
        },
        "runtime": {
          "maxLength": 32768,
          "type": "string"
        },
        "runtime_revision": {
          "maxLength": 32768,
          "type": "string"
        },
        "surface": {
          "maxLength": 32768,
          "type": "string"
        },
        "tool_policy_ref": {
          "maxLength": 32768,
          "type": "string"
        }
