{
  "$defs": {
    "BudgetLimit": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "maximum": 1000000000000000,
          "minimum": -1000000000000000,
          "type": "integer"
        },
        "metric": {
          "enum": [
            "input_tokens",
            "output_tokens",
            "tool_calls",
            "wall_time"
          ]
        },
        "scope": {
          "enum": [
            "trial",
            "campaign"
          ]
        },
        "unit": {
          "enum": [
            "tokens",
            "calls",
            "milliseconds"
          ]
        }
      },
      "required": [
        "metric",
        "scope",
        "unit",
        "maximum"
      ],
      "type": "object"
    },
    "BudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "exhaustion_disposition": {
          "enum": [
            "reject",
            "mark_incomplete"
          ]
        },
        "limits": {
          "items": {
            "$ref": "#/$defs/BudgetLimit"
          },
          "maxItems": 100000,
          "type": "array"
        }
      },
      "required": [
        "limits",
        "exhaustion_disposition"
      ],
      "type": "object"
    },
    "CampaignCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 32768,
          "type": "string"
        },
        "case_sha256": {
          "maxLength": 32768,
          "type": "string"
        },
        "input_sha256": {
          "maxLength": 32768,
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_sha256",
        "input_sha256"
      ],
      "type": "object"
    },
    "CampaignSpec": {
      "additionalProperties": false,
      "properties": {
        "arms": {
          "items": {
            "maxLength": 32768,
            "type": "string"
          },
          "maxItems": 100000,
          "type": "array"
        },
        "budget_policy": {
          "$ref": "#/$defs/BudgetPolicy"
        },
        "campaign_id": {
          "maxLength": 32768,
          "type": "string"
        },
        "cases": {
